# OmniRoute Configuration (LLM Provider)
FORGEAI_OMNIROUTE_BASE_URL=
FORGEAI_OMNIROUTE_API_KEY=
FORGEAI_OMNIROUTE_DEFAULT_MODEL=

# GitHub Integration
FORGEAI_GITHUB_TOKEN=

# Database
FORGEAI_DATABASE_URL=

# Agent Configuration
FORGEAI_AGENT_MAX_ITERATIONS=10

# Autonomous Execution
# Set to true to allow ForgeAI to autonomously mutate the workspace.
# Disabled by default as a safety measure.
FORGEAI_AUTONOMOUS_EXECUTION_ENABLED=false

# Maximum wall-clock seconds for a single execution (default: 3600 = 1 hour)
FORGEAI_MAX_EXECUTION_DURATION=3600

# Memory / History Store
# Set to true to enable cross-execution memory (requires SQLite).
FORGEAI_MEMORY_ENABLED=false
FORGEAI_MEMORY_DB_PATH=~/.forgeai/memory.db

# Workspace Authorization
# Colon-separated list of absolute paths that may be used as workspace roots
# via the API.  Empty = unrestricted (development only).
# Example: FORGEAI_ALLOWED_WORKSPACE_ROOTS=/srv/repos:/data/projects
FORGEAI_ALLOWED_WORKSPACE_ROOTS=

# Maximum character length for task strings accepted via the API.
FORGEAI_API_TASK_MAX_LENGTH=16000
